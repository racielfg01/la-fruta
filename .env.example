# PocketBase
NEXT_PUBLIC_POCKETBASE_URL=https://tu-proyecto.pockethost.io
POCKETBASE_ADMIN_EMAIL=admin@ejemplo.com
POCKETBASE_ADMIN_PASSWORD=cambia-esta-clave

# Subidas de imágenes
UPLOADTHING_TOKEN=

# Web Push (VAPID). Genera un par con:
#   npx web-push generate-vapid-keys
# La clave privada solo vive en el servidor; nunca uses NEXT_PUBLIC_ para ella.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://mercatoma.vercel.app
